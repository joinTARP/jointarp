{
  "name": "@jointarp/module-cli",
  "version": "0.1.0",
  "homepage": "https://jointarp.party",
  "license": "GPL-3.0-only",
  "bin": {
    "tarp": "./out/index.js"
  },
  "type": "module",
  "exports": {
    "./commands": "./src/commands.ts"
  },
  "scripts": {
    "cli": "bun out/index.js",
    "build": "bun scripts/build.mjs",
    "typecheck": "bun --bun x --no-install tsc --noEmit",
    "test": "bun ../../scripts/test.ts --scope @jointarp/module-cli",
    "pack": "bun ../../scripts/tasks.ts run build --filter=./packages/module-cli && bun pm pack --cwd out --filename tarp-module-cli.tgz",
    "test:changed": "bun ../../scripts/test.ts --scope @jointarp/module-cli --changed"
  },
  "dependencies": {
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jointarp/module": "workspace:*",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
