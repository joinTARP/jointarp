{
  "name": "@jointarp/module",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    "./node/*": "./src/node/*.ts",
    "./testing/*": "./src/testing/*.ts",
    "./*": "./src/schema/*.ts"
  },
  "scripts": {
    "typecheck": "bun --bun x --no-install tsc --noEmit",
    "test": "bun ../../scripts/test.ts --scope @jointarp/module",
    "test:changed": "bun ../../scripts/test.ts --scope @jointarp/module --changed"
  },
  "dependencies": {
    "handlebars": "^4.7.10",
    "htmlparser2": "^12.0.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sinonjs/fake-timers": "^15.4.0",
    "@types/bun": "^1.4.4",
    "@types/yauzl": "^2.10.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
