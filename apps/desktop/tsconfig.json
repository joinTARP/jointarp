{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"],
      "electrobun": ["./.hutch/devkit/api/sdks/main/index.ts"],
      "electrobun/main": ["./.hutch/devkit/api/sdks/main/index.ts"],
      "electrobun/view": ["./.hutch/devkit/api/browser/index.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun", "vite/client"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "vite.config.ts",
    "electrobun.config.ts",
    "hutch.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/desktop.ts",
    "scripts/renderer-csp.ts",
    "scripts/runtime-smoke.ts",
    "../../scripts/test.ts",
    "../../scripts/test-preload.ts",
    "../../scripts/release/smoke.ts",
    "scripts/webrtc-probe/*.ts",
    "scripts/p2p-probe/*.ts",
    "scripts/bun-webrtc-probe/*.ts"
  ]
}
