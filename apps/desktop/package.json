{
  "name": "@jointarp/desktop",
  "version": "0.1.2",
  "private": true,
  "description": "由 AI 主持的桌面跑团应用。",
  "homepage": "https://jointarp.party",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/desktop.ts dev",
    "build": "bun run scripts/desktop.ts build",
    "typecheck": "bun run prepare:desktop && bun --bun x --no-install tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun ../../scripts/test.ts --scope @jointarp/desktop",
    "test:changed": "bun ../../scripts/test.ts --scope @jointarp/desktop --changed",
    "preview": "electrobun dev",
    "package": "bun run scripts/desktop.ts package",
    "dist": "bun run scripts/desktop.ts dist",
    "prepare:desktop": "electrobun prepare",
    "build:renderer": "bun --bun x --no-install vite build"
  },
  "dependencies": {
