    "@jointarp/module": "workspace:*",
    "@jointarp/module-cli": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@orpc/client": "^2.0.0-beta.36",
    "@orpc/contract": "^2.0.0-beta.36",
