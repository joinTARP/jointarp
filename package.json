{
  "name": "tarp",
  "private": true,
  "homepage": "https://jointarp.party",
  "license": "GPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @jointarp/desktop dev",
    "cli": "bun packages/module-cli/out/index.js",
    "build": "bun scripts/tasks.ts run build",
    "typecheck": "bun scripts/tasks.ts run typecheck",
    "test": "bun scripts/test.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "package": "bun run --filter @jointarp/desktop package",
    "dist": "bun run --filter @jointarp/desktop dist",
    "prepare": "simple-git-hooks",
    "test:changed": "bun scripts/test.ts --changed"
  },
  "dependencies": {
    "fast-json-patch": "^3.1.1",
    "nanoid": "^6.0.2"
  },
  "devDependencies": {
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.68.0",
    "simple-git-hooks": "^2.14.0",
    "turbo": "2.11.10"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx --bun lint-staged"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
